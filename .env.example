# Sift Application Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server Runtime
SIFT_ENV=development
SIFT_HOST=0.0.0.0
SIFT_PORT=8000
SIFT_FRONTEND_ORIGIN=http://localhost:5173
SIFT_API_RATE_LIMIT_PER_MINUTE=60
SIFT_ADMIN_TOKEN=sift-secret-admin-token
SIFT_SENTRY_DSN=

# Storage (PostgreSQL 16 with pgvector extension)
SIFT_DATABASE_URL=postgresql+asyncpg://adityasurse@localhost:5432/sift_dev
DATABASE_URL=postgresql+asyncpg://adityasurse@localhost:5432/sift_dev
SIFT_TEST_DATABASE_URL=postgresql+asyncpg://adityasurse@localhost:5432/sift_test

# Polite Crawler Settings
SIFT_CRAWLER_USER_AGENT="SiftBot/1.0 (+https://siftjobs.com/bot; crawler@siftjobs.com)"
SIFT_CRAWLER_DEFAULT_DELAY_SEC=1.5
SIFT_CRAWLER_TIMEOUT_SEC=15.0
SIFT_CRAWLER_MAX_CONCURRENCY_PER_DOMAIN=1

# LLM Enrichment & Embeddings (Gemini)
SIFT_LLM_PROVIDER=gemini
SIFT_LLM_MODEL=gemini-1.5-flash
SIFT_EMBEDDING_MODEL=text-embedding-004
SIFT_LLM_RPM_LIMIT=15
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Web Application (frontend/.env)
# VITE_API_URL=/api (defaults to proxying to backend)
