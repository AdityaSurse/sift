# Sift Application Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server Configuration
SIFT_ENV=development
SIFT_HOST=0.0.0.0
SIFT_PORT=8000

# Storage
# Supabase Postgres / PostgreSQL with pgvector extension (asyncpg driver)
SIFT_DATABASE_URL=postgresql+asyncpg://adityasurse@localhost:5432/sift_dev
# Test Database URL for pytest runs
SIFT_TEST_DATABASE_URL=postgresql+asyncpg://adityasurse@localhost:5432/sift_test

# Polite Crawler Settings
# Clear User-Agent identifying Sift and providing contact info
SIFT_CRAWLER_USER_AGENT="SiftBot/1.0 (+https://siftjobs.com/bot; crawler@siftjobs.com)"
# Minimum delay between requests to the same domain (seconds)
SIFT_CRAWLER_DEFAULT_DELAY_SEC=1.5
# Request timeout in seconds
SIFT_CRAWLER_TIMEOUT_SEC=15.0
# Maximum concurrent requests per domain
SIFT_CRAWLER_MAX_CONCURRENCY_PER_DOMAIN=1

# LLM Enrichment Provider (gemini | openai | anthropic)
SIFT_LLM_PROVIDER=gemini
SIFT_LLM_MODEL=gemini-1.5-flash
# Provide one of the API keys depending on the chosen provider:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
